{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# Agent Inventory for Permissions and Risks\nThis workbook provides an overview of Microsoft Agent identities, their sign-in activities, credential types, and permission classifications based on the Enterprise Access Model (EAM).\n\n**Prerequisites** (Log Analytics workspace):\n- Required: `AADServicePrincipalSignInLogs`, `AADNonInteractiveUserSignInLogs`, `MicrosoftGraphActivityLogs` (Entra ID diagnostic settings)\n- Optional: `BehaviorAnalytics` (Microsoft Sentinel UEBA) and `AADRiskyAgents` (risk columns stay empty without them)\n\n**Agent Highest EAM Tier** is the highest tier of any Entra role, application permission or delegated permission seen in the agent's Microsoft Graph tokens during the lookback period."
      },
      "name": "title"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "a1b2c3d4-0001-4000-8000-000000000001",
            "version": "KqlParameterItem/1.0",
            "name": "SelectLogAnalytics",
            "label": "Select Workspace",
            "type": 5,
            "isRequired": true,
            "query": "resources\r\n| where type == \"microsoft.operationalinsights/workspaces\"\r\n| project id",
            "crossComponentResources": [
              "value::selected"
            ],
            "typeSettings": {
              "additionalResourceOptions": []
            },
            "timeContext": {
              "durationMs": 86400000
            },
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          },
          {
            "id": "a1b2c3d4-0002-4000-8000-000000000002",
            "version": "KqlParameterItem/1.0",
            "name": "Lookback",
            "label": "Lookback Period",
            "type": 2,
            "isRequired": true,
            "typeSettings": {
              "additionalResourceOptions": []
            },
            "jsonData": "[{\"value\":\"1h\",\"label\":\"Last 1 hour\"},{\"value\":\"1d\",\"label\":\"Last 1 day\"},{\"value\":\"3d\",\"label\":\"Last 3 days\"},{\"value\":\"7d\",\"label\":\"Last 7 days\"},{\"value\":\"14d\",\"label\":\"Last 14 days\"},{\"value\":\"30d\",\"label\":\"Last 30 days\"}]",
            "value": "30d"
          },
          {
            "id": "a1b2c3d4-0003-4000-8000-000000000003",
            "version": "KqlParameterItem/1.0",
            "name": "AgentBlueprintId",
            "label": "Agent Blueprint ID",
            "type": 1,
            "description": "Enter an Agent Blueprint App ID (parentAppId) to filter, or leave empty for all agents",
            "value": "",
            "typeSettings": {
              "paramValidationRules": [
                {
                  "regExp": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$",
                  "match": true,
                  "message": "Enter a valid Agent Blueprint App ID (GUID) or leave empty."
                }
              ]
            }
          },
          {
            "id": "a1b2c3d4-0004-4000-8000-000000000004",
            "version": "KqlParameterItem/1.0",
            "name": "PrincipalType",
            "type": 2,
            "isRequired": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::all"
              ],
              "selectAllValue": "*",
              "showDefault": false
            },
            "jsonData": "[{\"value\":\"AgentIdentity\", \"label\":\"Agent Identity\"},{\"value\":\"AgentUser\", \"label\":\"Agent User\"},{\"value\":\"AgentIdentityBlueprint\", \"label\":\"Agent Identity Blueprint\"},{\"value\":\"AgentIdentityBlueprintPrincipal\", \"label\":\"Agent Identity Blueprint Principal\"}]",
            "defaultValue": "value::all"
          },
          {
            "id": "a1b2c3d4-0005-4000-8000-000000000005",
            "version": "KqlParameterItem/1.0",
            "name": "IdentityFilter",
            "label": "Identity Name",
            "type": 1,
            "value": "",
            "typeSettings": {
              "paramValidationRules": [
                {
                  "regExp": "^[^'\\\"\\\\]*$",
                  "match": true,
                  "message": "Quotes and backslashes are not supported in the identity name filter."
                }
              ]
            },
            "description": "Filter by (part of) the agent display name, or leave empty for all agents"
          }
        ],
        "style": "pills",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters - filters"
    },
    {
      "type": 1,
      "content": {
        "json": "## Overview Tiles"
      },
      "name": "section-overview"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let SupportedAgentTypes = dynamic([\"agenticApp\", \"agentIdentityBlueprintPrincipal\", \"agenticAppInstance\"]);\r\nlet AgentIdentitiesSignIns = AADServicePrincipalSignInLogs\r\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\r\n| where tostring(parse_json(Agent)[\"agentType\"]) in (SupportedAgentTypes)\r\n| extend AgentType = tostring(parse_json(Agent)[\"agentType\"])\r\n| where tostring(parse_json(Agent)[\"parentAppId\"]) =~ '{AgentBlueprintId}' or '{AgentBlueprintId}' == \"\"\r\n| extend PrincipalType = case(\r\n    AgentType == \"agenticApp\", \"AgentIdentityBlueprint\",\r\n    AgentType == \"agenticAppInstance\", \"AgentIdentity\",\r\n    AgentType == \"agentIdentityBlueprintPrincipal\", \"AgentIdentityBlueprintPrincipal\",\r\n    \"Unknown\"\r\n    )\r\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\r\n| project PrincipalType, PrincipalId = ServicePrincipalId, Identity = ServicePrincipalName, ClientCredentialType, UniqueTokenIdentifier, SessionId, AgentSubjectParentId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]), AppId;\r\nlet AgentIdentitiesIds = AgentIdentitiesSignIns | where PrincipalType == \"AgentIdentity\" | distinct AppId;\r\nlet AgentUsersSignIns = AADNonInteractiveUserSignInLogs\r\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\r\n| where isnotempty(Agent)\r\n| where tostring(parse_json(Agent)[\"agentSubjectParentId\"]) in~ (AgentIdentitiesIds)\r\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\r\n| project PrincipalType = \"AgentUser\", PrincipalId = UserId, Identity, ClientCredentialType, UniqueTokenIdentifier, SessionId, AgentSubjectParentId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]), AppId;\r\nlet AgentObjects = union AgentIdentitiesSignIns, AgentUsersSignIns\r\n| where PrincipalType in ({PrincipalType}) or '*' in ({PrincipalType})\r\n| where Identity contains '{IdentityFilter}' or '{IdentityFilter}' == \"\"\r\n| summarize CredentialType = make_set(ClientCredentialType) by Identity, AgentSubjectParentId, PrincipalId, PrincipalType\r\n| mv-expand CredentialType to typeof(string)\r\n| where isnotempty(CredentialType)\r\n| summarize Count = dcount(strcat(AgentSubjectParentId, '|', PrincipalId)) by CredentialType\r\n| sort by Count desc;\r\nAgentObjects",
        "size": 4,
        "title": "Agents by Credential Type",
        "timeContext": {
          "durationMs": 2592000000
        },
        "exportFieldName": "CredentialType",
        "exportParameterName": "SelectedCredentialType",
        "exportDefaultValue": "*",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{SelectLogAnalytics}"
        ],
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": {
            "columnMatch": "CredentialType",
            "formatter": 1
          },
          "leftContent": {
            "columnMatch": "Count",
            "formatter": 12,
            "formatOptions": {
              "palette": "auto"
            },
            "numberFormat": {
              "unit": 17,
              "options": {
                "maximumSignificantDigits": 3,
                "maximumFractionDigits": 2
              }
            }
          },
          "showBorder": false
        }
      },
      "customWidth": "33",
      "name": "tile-credential-type",
      "styleSettings": {
        "maxWidth": "33",
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let SupportedAgentTypes = dynamic([\"agenticApp\", \"agentIdentityBlueprintPrincipal\", \"agenticAppInstance\"]);\r\nlet AgentIdentitiesSignIns = AADServicePrincipalSignInLogs\r\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\r\n| where tostring(parse_json(Agent)[\"agentType\"]) in (SupportedAgentTypes)\r\n| extend AgentType = tostring(parse_json(Agent)[\"agentType\"])\r\n| where tostring(parse_json(Agent)[\"parentAppId\"]) =~ '{AgentBlueprintId}' or '{AgentBlueprintId}' == \"\"\r\n| extend PrincipalType = case(\r\n    AgentType == \"agenticApp\", \"AgentIdentityBlueprint\",\r\n    AgentType == \"agenticAppInstance\", \"AgentIdentity\",\r\n    AgentType == \"agentIdentityBlueprintPrincipal\", \"AgentIdentityBlueprintPrincipal\",\r\n    \"Unknown\"\r\n    )\r\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\r\n| project PrincipalType, PrincipalId = ServicePrincipalId, Identity = ServicePrincipalName, ClientCredentialType, AppId, AgentSubjectParentId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]);\r\nlet AgentIdentitiesIds = AgentIdentitiesSignIns | where PrincipalType == \"AgentIdentity\" | distinct AppId;\r\nlet AgentUsersSignIns = AADNonInteractiveUserSignInLogs\r\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\r\n| where isnotempty(Agent)\r\n| where tostring(parse_json(Agent)[\"agentSubjectParentId\"]) in~ (AgentIdentitiesIds)\r\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\r\n| project PrincipalType = \"AgentUser\", PrincipalId = UserId, Identity, ClientCredentialType, AppId, AgentSubjectParentId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]);\r\nlet AgentObjects = union AgentIdentitiesSignIns, AgentUsersSignIns\r\n| where PrincipalType in ({PrincipalType}) or '*' in ({PrincipalType})\r\n| where Identity contains '{IdentityFilter}' or '{IdentityFilter}' == \"\"\r\n| summarize count() by Identity, AgentSubjectParentId, PrincipalId, PrincipalType;\r\nlet AgentIds = AgentObjects | summarize by PrincipalId;\r\nlet AgentIdList = toscalar(AgentIds | summarize make_set(PrincipalId));\r\nlet DirectoryRolesClassification = materialize(\r\n    externaldata(RoleId: string, RoleName: string, isPrivileged: bool, Categories: string, Classification: dynamic)\r\n    [@\"https://raw.githubusercontent.com/Cloud-Architekt/AzurePrivilegedIAM/main/Classification/Classification_EntraIdDirectoryRoles.json\"]\r\n    with (format=\"multijson\")\r\n    | project RoleId, RoleName, isPrivileged, WidsCategories = Categories, WidsEAMTierLevelName = tostring(Classification.EAMTierLevelName), WidsEAMTierLevelTagValue = tostring(Classification.EAMTierLevelTagValue)\r\n);\r\nlet AppRolesClassification = materialize(\r\n    externaldata(AppId: string, AppRoleId: string, AppRoleDisplayName: string, Category: string, EAMTierLevelName: string, EAMTierLevelTagValue: string)\r\n    [@\"https://raw.githubusercontent.com/Cloud-Architekt/AzurePrivilegedIAM/main/Classification/Classification_AppRoles.json\"]\r\n    with (format=\"multijson\")\r\n    | where AppId == \"00000003-0000-0000-c000-000000000000\"\r\n    | project-away AppId\r\n    | extend AppRoleName = AppRoleDisplayName\r\n);\r\nlet BaseData = materialize(\r\n    MicrosoftGraphActivityLogs\r\n    | where TimeGenerated > ago(totimespan('{Lookback}'))\r\n    | where UserId in~ (AgentIds) or AppId in~ (AgentIds) or ServicePrincipalId in~ (AgentIds)\r\n    | extend Scopes = split(Scopes, ' ')\r\n    | extend Roles = split(Roles, ' ')\r\n    | extend Wids = split(Wids, ' ')\r\n    | extend PrincipalId = iff(isnotempty(UserId), UserId, iff(AppId in~ (AgentIdList), AppId, iff(ServicePrincipalId in~ (AgentIdList), ServicePrincipalId, \"\")))\r\n    | where isnotempty(PrincipalId)\r\n    | project PrincipalId, Wids, Roles, Scopes\r\n    | summarize Wids = array_concat(make_set(Wids)), Roles = array_concat(make_set(Roles)), Scopes = array_concat(make_set(Scopes)) by PrincipalId\r\n);\r\nlet EnrichedWids = BaseData | project PrincipalId, Wids | mv-expand Wid = Wids to typeof(string) | where isnotempty(Wid) | lookup kind=leftouter hint.strategy=broadcast DirectoryRolesClassification on $left.Wid == $right.RoleId | summarize EnrichedWids = make_set(pack(\"RoleId\", coalesce(Wid, \"\"), \"RoleName\", coalesce(RoleName, \"\"), \"isPrivileged\", coalesce(isPrivileged, false), \"Categories\", coalesce(WidsCategories, \"\"), \"EAMTierLevel\", coalesce(WidsEAMTierLevelName, \"\"), \"EAMTierLevelTag\", coalesce(WidsEAMTierLevelTagValue, \"\"))) by PrincipalId;\r\nlet EnrichedScopes = BaseData | project PrincipalId, Scopes | mv-expand Scope = Scopes to typeof(string) | where isnotempty(Scope) | lookup kind=leftouter hint.strategy=broadcast AppRolesClassification on $left.Scope == $right.AppRoleName | summarize EnrichedScopes = make_set(pack(\"PermissionValue\", coalesce(Scope, \"\"), \"AppRoleName\", coalesce(AppRoleDisplayName, \"\"), \"Category\", coalesce(Category, \"\"), \"EAMTierLevel\", coalesce(EAMTierLevelName, \"\"), \"EAMTierLevelTag\", coalesce(EAMTierLevelTagValue, \"\"))) by PrincipalId;\r\nlet EnrichedRoles = BaseData | project PrincipalId, Roles | mv-expand Role = Roles to typeof(string) | where isnotempty(Role) | lookup kind=leftouter hint.strategy=broadcast AppRolesClassification on $left.Role == $right.AppRoleName | summarize EnrichedRoles = make_set(pack(\"PermissionValue\", coalesce(Role, \"\"), \"AppRoleName\", coalesce(AppRoleDisplayName, \"\"), \"Category\", coalesce(Category, \"\"), \"EAMTierLevel\", coalesce(EAMTierLevelName, \"\"), \"EAMTierLevelTag\", coalesce(EAMTierLevelTagValue, \"\"))) by PrincipalId;\r\nlet AgentEnrichedData = BaseData\r\n| project PrincipalId\r\n| join kind=leftouter EnrichedWids on PrincipalId\r\n| join kind=leftouter EnrichedRoles on PrincipalId\r\n| join kind=leftouter EnrichedScopes on PrincipalId\r\n| project PrincipalId, EnrichedWids, EnrichedRoles, EnrichedScopes\r\n| mv-apply WidsItem = EnrichedWids on (summarize WidsCategories = make_set(tostring(WidsItem.Categories)), WidsEAMTiers = make_set(tostring(WidsItem.EAMTierLevel)))\r\n| mv-apply RolesItem = EnrichedRoles on (summarize RolesCategories = make_set(tostring(RolesItem.Category)), RolesEAMTiers = make_set(tostring(RolesItem.EAMTierLevel)))\r\n| mv-apply ScopesItem = EnrichedScopes on (summarize ScopesCategories = make_set(tostring(ScopesItem.Category)), ScopesEAMTiers = make_set(tostring(ScopesItem.EAMTierLevel)))\r\n| extend AllCategories = set_difference(set_union(WidsCategories, RolesCategories, ScopesCategories), dynamic([\"\"])),\r\n         AllEAMTiers = set_difference(set_union(WidsEAMTiers, RolesEAMTiers, ScopesEAMTiers), dynamic([\"\"]))\r\n| extend HighestEAMTierLevel = case(set_has_element(AllEAMTiers, \"ControlPlane\"), \"ControlPlane\", set_has_element(AllEAMTiers, \"ManagementPlane\"), \"ManagementPlane\", set_has_element(AllEAMTiers, \"WorkloadPlane\"), \"WorkloadPlane\", set_has_element(AllEAMTiers, \"UserAccess\"), \"UserAccess\", \"\")\r\n| project PrincipalId, EnrichedWids, EnrichedRoles, EnrichedScopes, AllCategories, HighestEAMTierLevel;\r\nAgentObjects\r\n| join kind=leftouter (AgentEnrichedData) on PrincipalId\r\n| extend HighestEAMTierLevel = coalesce(HighestEAMTierLevel, \"Unclassified\")\r\n| distinct AgentSubjectParentId, PrincipalId, HighestEAMTierLevel\r\n| summarize Count = count() by HighestEAMTierLevel\r\n| join kind=fullouter (datatable(HighestEAMTierLevel:string)['ControlPlane','ManagementPlane','WorkloadPlane','UserAccess','Unclassified']) on HighestEAMTierLevel\r\n| project HighestEAMTierLevel = iff(HighestEAMTierLevel == '', HighestEAMTierLevel1, HighestEAMTierLevel), Count = iff(HighestEAMTierLevel == '', 0, Count)\r\n| extend SortOrder = case(HighestEAMTierLevel == \"ControlPlane\", 1, HighestEAMTierLevel == \"ManagementPlane\", 2, HighestEAMTierLevel == \"WorkloadPlane\", 3, HighestEAMTierLevel == \"UserAccess\", 4, 5)\r\n| order by SortOrder asc\r\n| project-away SortOrder",
        "size": 4,
        "title": "Agents by EAM Tier Level",
        "timeContext": {
          "durationMs": 2592000000
        },
        "exportFieldName": "HighestEAMTierLevel",
        "exportParameterName": "SelectedEAMTier",
        "exportDefaultValue": "*",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{SelectLogAnalytics}"
        ],
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": {
            "columnMatch": "HighestEAMTierLevel",
            "formatter": 1
          },
          "leftContent": {
            "columnMatch": "Count",
            "formatter": 12,
            "formatOptions": {
              "palette": "auto"
            },
            "numberFormat": {
              "unit": 17,
              "options": {
                "maximumSignificantDigits": 3,
                "maximumFractionDigits": 2
              }
            }
          },
          "showBorder": false
        }
      },
      "customWidth": "33",
      "name": "tile-eam-tier",
      "styleSettings": {
        "maxWidth": "33",
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let SupportedAgentTypes = dynamic([\"agenticApp\", \"agentIdentityBlueprintPrincipal\", \"agenticAppInstance\"]);\r\nlet AgentIdentitiesSignIns = AADServicePrincipalSignInLogs\r\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\r\n| where tostring(parse_json(Agent)[\"agentType\"]) in (SupportedAgentTypes)\r\n| extend AgentType = tostring(parse_json(Agent)[\"agentType\"])\r\n| where tostring(parse_json(Agent)[\"parentAppId\"]) =~ '{AgentBlueprintId}' or '{AgentBlueprintId}' == \"\"\r\n| extend PrincipalType = case(\r\n    AgentType == \"agenticApp\", \"AgentIdentityBlueprint\",\r\n    AgentType == \"agenticAppInstance\", \"AgentIdentity\",\r\n    AgentType == \"agentIdentityBlueprintPrincipal\", \"AgentIdentityBlueprintPrincipal\",\r\n    \"Unknown\"\r\n    )\r\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\r\n| project PrincipalType, PrincipalId = ServicePrincipalId, Identity = ServicePrincipalName, AppId, AgentSubjectParentId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]);\r\nlet AgentIdentitiesIds = AgentIdentitiesSignIns | where PrincipalType == \"AgentIdentity\" | distinct AppId;\r\nlet AgentUsersSignIns = AADNonInteractiveUserSignInLogs\r\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\r\n| where isnotempty(Agent)\r\n| where tostring(parse_json(Agent)[\"agentSubjectParentId\"]) in~ (AgentIdentitiesIds)\r\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\r\n| project PrincipalType = \"AgentUser\", PrincipalId = UserId, Identity, AppId, AgentSubjectParentId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]);\r\nlet AgentObjects = union AgentIdentitiesSignIns, AgentUsersSignIns\r\n| where PrincipalType in ({PrincipalType}) or '*' in ({PrincipalType})\r\n| where Identity contains '{IdentityFilter}' or '{IdentityFilter}' == \"\"\r\n| summarize count() by Identity, AgentSubjectParentId, PrincipalId, PrincipalType\r\n| summarize Count = dcount(strcat(AgentSubjectParentId, '|', PrincipalId)) by PrincipalType\r\n| join kind=fullouter (datatable(PrincipalType:string)['AgentIdentity','AgentUser','AgentIdentityBlueprint','AgentIdentityBlueprintPrincipal']\r\n    | where PrincipalType in ({PrincipalType}) or '*' in ({PrincipalType})) on PrincipalType\r\n| project PrincipalType = iff(PrincipalType == '', PrincipalType1, PrincipalType), Count = iff(PrincipalType == '', 0, Count);\r\nAgentObjects",
        "size": 4,
        "title": "Agents by Principal Type",
        "timeContext": {
          "durationMs": 2592000000
        },
        "exportFieldName": "PrincipalType",
        "exportParameterName": "SelectedPrincipalType",
        "exportDefaultValue": "*",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{SelectLogAnalytics}"
        ],
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": {
            "columnMatch": "PrincipalType",
            "formatter": 1
          },
          "leftContent": {
            "columnMatch": "Count",
            "formatter": 12,
            "formatOptions": {
              "palette": "auto"
            },
            "numberFormat": {
              "unit": 17,
              "options": {
                "maximumSignificantDigits": 3,
                "maximumFractionDigits": 2
              }
            }
          },
          "showBorder": false
        }
      },
      "customWidth": "33",
      "name": "tile-principal-type",
      "styleSettings": {
        "maxWidth": "33",
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let SupportedAgentTypes = dynamic([\"agenticApp\", \"agentIdentityBlueprintPrincipal\", \"agenticAppInstance\"]);\r\nlet AgentIdentitiesSignIns = AADServicePrincipalSignInLogs\r\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\r\n| where tostring(parse_json(Agent)[\"agentType\"]) in (SupportedAgentTypes)\r\n| extend AgentType = tostring(parse_json(Agent)[\"agentType\"])\r\n| where tostring(parse_json(Agent)[\"parentAppId\"]) =~ '{AgentBlueprintId}' or '{AgentBlueprintId}' == \"\"\r\n| extend PrincipalType = case(\r\n    AgentType == \"agenticApp\", \"AgentIdentityBlueprint\",\r\n    AgentType == \"agenticAppInstance\", \"AgentIdentity\",\r\n    AgentType == \"agentIdentityBlueprintPrincipal\", \"AgentIdentityBlueprintPrincipal\",\r\n    \"Unknown\"\r\n    )\r\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\r\n| project PrincipalType, PrincipalId = ServicePrincipalId, Identity = ServicePrincipalName, ClientCredentialType, AppId, AgentSubjectParentId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]);\r\nlet AgentIdentitiesIds = AgentIdentitiesSignIns | where PrincipalType == \"AgentIdentity\" | distinct AppId;\r\nlet AgentUsersSignIns = AADNonInteractiveUserSignInLogs\r\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\r\n| where isnotempty(Agent)\r\n| where tostring(parse_json(Agent)[\"agentSubjectParentId\"]) in~ (AgentIdentitiesIds)\r\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\r\n| project PrincipalType = \"AgentUser\", PrincipalId = UserId, Identity, ClientCredentialType, AppId, AgentSubjectParentId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]);\r\nlet AgentObjects = union AgentIdentitiesSignIns, AgentUsersSignIns\r\n| where PrincipalType in ({PrincipalType}) or '*' in ({PrincipalType})\r\n| where Identity contains '{IdentityFilter}' or '{IdentityFilter}' == \"\"\r\n| summarize count() by Identity, AgentSubjectParentId, PrincipalId, PrincipalType;\r\nlet AgentIds = AgentObjects | summarize by PrincipalId;\r\nlet AgentIdList = toscalar(AgentIds | summarize make_set(PrincipalId));\r\nlet DirectoryRolesClassification = materialize(\r\n    externaldata(RoleId: string, RoleName: string, isPrivileged: bool, Categories: string, Classification: dynamic)\r\n    [@\"https://raw.githubusercontent.com/Cloud-Architekt/AzurePrivilegedIAM/main/Classification/Classification_EntraIdDirectoryRoles.json\"]\r\n    with (format=\"multijson\")\r\n    | project RoleId, RoleName, isPrivileged, WidsCategories = Categories, WidsEAMTierLevelName = tostring(Classification.EAMTierLevelName), WidsEAMTierLevelTagValue = tostring(Classification.EAMTierLevelTagValue)\r\n);\r\nlet AppRolesClassification = materialize(\r\n    externaldata(AppId: string, AppRoleId: string, AppRoleDisplayName: string, Category: string, EAMTierLevelName: string, EAMTierLevelTagValue: string)\r\n    [@\"https://raw.githubusercontent.com/Cloud-Architekt/AzurePrivilegedIAM/main/Classification/Classification_AppRoles.json\"]\r\n    with (format=\"multijson\")\r\n    | where AppId == \"00000003-0000-0000-c000-000000000000\"\r\n    | project-away AppId\r\n    | extend AppRoleName = AppRoleDisplayName\r\n);\r\nlet BaseData = materialize(\r\n    MicrosoftGraphActivityLogs\r\n    | where TimeGenerated > ago(totimespan('{Lookback}'))\r\n    | where UserId in~ (AgentIds) or AppId in~ (AgentIds) or ServicePrincipalId in~ (AgentIds)\r\n    | extend Scopes = split(Scopes, ' ')\r\n    | extend Roles = split(Roles, ' ')\r\n    | extend Wids = split(Wids, ' ')\r\n    | extend PrincipalId = iff(isnotempty(UserId), UserId, iff(AppId in~ (AgentIdList), AppId, iff(ServicePrincipalId in~ (AgentIdList), ServicePrincipalId, \"\")))\r\n    | where isnotempty(PrincipalId)\r\n    | project PrincipalId, Wids, Roles, Scopes\r\n    | summarize Wids = array_concat(make_set(Wids)), Roles = array_concat(make_set(Roles)), Scopes = array_concat(make_set(Scopes)) by PrincipalId\r\n);\r\nlet EnrichedWids = BaseData | project PrincipalId, Wids | mv-expand Wid = Wids to typeof(string) | where isnotempty(Wid) | lookup kind=leftouter hint.strategy=broadcast DirectoryRolesClassification on $left.Wid == $right.RoleId | summarize EnrichedWids = make_set(pack(\"RoleId\", coalesce(Wid, \"\"), \"RoleName\", coalesce(RoleName, \"\"), \"isPrivileged\", coalesce(isPrivileged, false), \"Categories\", coalesce(WidsCategories, \"\"), \"EAMTierLevel\", coalesce(WidsEAMTierLevelName, \"\"), \"EAMTierLevelTag\", coalesce(WidsEAMTierLevelTagValue, \"\"))) by PrincipalId;\r\nlet EnrichedScopes = BaseData | project PrincipalId, Scopes | mv-expand Scope = Scopes to typeof(string) | where isnotempty(Scope) | lookup kind=leftouter hint.strategy=broadcast AppRolesClassification on $left.Scope == $right.AppRoleName | summarize EnrichedScopes = make_set(pack(\"PermissionValue\", coalesce(Scope, \"\"), \"AppRoleName\", coalesce(AppRoleDisplayName, \"\"), \"Category\", coalesce(Category, \"\"), \"EAMTierLevel\", coalesce(EAMTierLevelName, \"\"), \"EAMTierLevelTag\", coalesce(EAMTierLevelTagValue, \"\"))) by PrincipalId;\r\nlet EnrichedRoles = BaseData | project PrincipalId, Roles | mv-expand Role = Roles to typeof(string) | where isnotempty(Role) | lookup kind=leftouter hint.strategy=broadcast AppRolesClassification on $left.Role == $right.AppRoleName | summarize EnrichedRoles = make_set(pack(\"PermissionValue\", coalesce(Role, \"\"), \"AppRoleName\", coalesce(AppRoleDisplayName, \"\"), \"Category\", coalesce(Category, \"\"), \"EAMTierLevel\", coalesce(EAMTierLevelName, \"\"), \"EAMTierLevelTag\", coalesce(EAMTierLevelTagValue, \"\"))) by PrincipalId;\r\nlet AgentEnrichedData = BaseData\r\n| project PrincipalId\r\n| join kind=leftouter EnrichedWids on PrincipalId\r\n| join kind=leftouter EnrichedRoles on PrincipalId\r\n| join kind=leftouter EnrichedScopes on PrincipalId\r\n| project PrincipalId, EnrichedWids, EnrichedRoles, EnrichedScopes\r\n| mv-apply WidsItem = EnrichedWids on (summarize WidsCategories = make_set(tostring(WidsItem.Categories)), WidsEAMTiers = make_set(tostring(WidsItem.EAMTierLevel)))\r\n| mv-apply RolesItem = EnrichedRoles on (summarize RolesCategories = make_set(tostring(RolesItem.Category)), RolesEAMTiers = make_set(tostring(RolesItem.EAMTierLevel)))\r\n| mv-apply ScopesItem = EnrichedScopes on (summarize ScopesCategories = make_set(tostring(ScopesItem.Category)), ScopesEAMTiers = make_set(tostring(ScopesItem.EAMTierLevel)))\r\n| extend AllCategories = set_difference(set_union(WidsCategories, RolesCategories, ScopesCategories), dynamic([\"\"])),\r\n         AllEAMTiers = set_difference(set_union(WidsEAMTiers, RolesEAMTiers, ScopesEAMTiers), dynamic([\"\"]))\r\n| extend HighestEAMTierLevel = case(set_has_element(AllEAMTiers, \"ControlPlane\"), \"ControlPlane\", set_has_element(AllEAMTiers, \"ManagementPlane\"), \"ManagementPlane\", set_has_element(AllEAMTiers, \"WorkloadPlane\"), \"WorkloadPlane\", set_has_element(AllEAMTiers, \"UserAccess\"), \"UserAccess\", \"\")\r\n| project PrincipalId, AllCategories, HighestEAMTierLevel;\r\nAgentObjects\r\n| join kind=leftouter (AgentEnrichedData) on PrincipalId\r\n| extend HighestEAMTierLevel = coalesce(HighestEAMTierLevel, \"Unclassified\")\r\n| extend AllCategories = iff(isnull(AllCategories), dynamic([]), AllCategories)\r\n| mv-expand Category = AllCategories to typeof(string)\r\n| where isnotempty(Category)\r\n| summarize Count = dcount(strcat(AgentSubjectParentId, '|', PrincipalId)) by Category\r\n| sort by Count desc",
        "size": 2,
        "title": "Agents by Permission Category",
        "timeContext": {
          "durationMs": 2592000000
        },
        "exportFieldName": "series",
        "exportParameterName": "SelectedCategory",
        "exportDefaultValue": "*",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{SelectLogAnalytics}"
        ],
        "visualization": "piechart"
      },
      "customWidth": "50",
      "name": "chart-categories",
      "styleSettings": {
        "maxWidth": "50",
        "showBorder": true
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let SupportedAgentTypes = dynamic([\"agenticApp\", \"agentIdentityBlueprintPrincipal\", \"agenticAppInstance\"]);\r\nlet AgentIdentitiesSignIns = AADServicePrincipalSignInLogs\r\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\r\n| where tostring(parse_json(Agent)[\"agentType\"]) in (SupportedAgentTypes)\r\n| extend AgentType = tostring(parse_json(Agent)[\"agentType\"])\r\n| where tostring(parse_json(Agent)[\"parentAppId\"]) =~ '{AgentBlueprintId}' or '{AgentBlueprintId}' == \"\"\r\n| extend PrincipalType = case(\r\n    AgentType == \"agenticApp\", \"AgentIdentityBlueprint\",\r\n    AgentType == \"agenticAppInstance\", \"AgentIdentity\",\r\n    AgentType == \"agentIdentityBlueprintPrincipal\", \"AgentIdentityBlueprintPrincipal\",\r\n    \"Unknown\"\r\n    )\r\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\r\n| project PrincipalType, PrincipalId = ServicePrincipalId, Identity = ServicePrincipalName, ClientCredentialType, AppId, ResourceDisplayName, AgentSubjectParentId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]);\r\nlet AgentIdentitiesIds = AgentIdentitiesSignIns | where PrincipalType == \"AgentIdentity\" | distinct AppId;\r\nlet AgentUsersSignIns = AADNonInteractiveUserSignInLogs\r\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\r\n| where isnotempty(Agent)\r\n| where tostring(parse_json(Agent)[\"agentSubjectParentId\"]) in~ (AgentIdentitiesIds)\r\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\r\n| project PrincipalType = \"AgentUser\", PrincipalId = UserId, Identity, ClientCredentialType, AppId, ResourceDisplayName, AgentSubjectParentId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]);\r\nunion AgentIdentitiesSignIns, AgentUsersSignIns\r\n| where PrincipalType in ({PrincipalType}) or '*' in ({PrincipalType})\r\n| where Identity contains '{IdentityFilter}' or '{IdentityFilter}' == \"\"\r\n| summarize SignInCount = count() by ResourceDisplayName\r\n| sort by SignInCount desc\r\n| take 15",
