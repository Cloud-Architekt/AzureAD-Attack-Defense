      },
      "name": "grid-agent-permissions"
    },
    {
      "type": 1,
      "content": {
        "json": "## Agent Activities to Microsoft Graph API\nSelect an agent in the inventory above, and optionally a permission in the permission details, to show the related Microsoft Graph requests. Requests are matched on the user ID (agent users) or on the application ID / service principal ID (agent identities and blueprint principals). Selecting an agent identity also lists delegated requests made by its agent users; the PrincipalId column shows who made each request."
      },
      "name": "section-activities"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "MicrosoftGraphActivityLogs\r\n    | where TimeGenerated > ago(totimespan('{Lookback}'))\r\n    | where UserId == '{SelectedPrincipal}' or AppId == '{SelectedPrincipal}' or ServicePrincipalId == '{SelectedPrincipal}'\r\n    | where '{SelectedRoleName}' == '*' or Scopes has '{SelectedRoleName}' or Roles has '{SelectedRoleName}' or Wids has '{SelectedRoleName}'\r\n    | extend Scopes = set_difference(split(Scopes, ' '), dynamic([\"\"]))\r\n    | extend Roles = set_difference(split(Roles, ' '), dynamic([\"\"]))\r\n    | extend Wids = set_difference(split(Wids, ' '), dynamic([\"\"]))\r\n    | where '{SelectedRoleName}' == '*' or set_has_element(Scopes, '{SelectedRoleName}') or set_has_element(Roles, '{SelectedRoleName}') or set_has_element(Wids, '{SelectedRoleName}')\r\n    | extend PrincipalId = coalesce(UserId, AppId)\r\n    | project-reorder PrincipalId, Wids, Roles, Scopes, SessionId, RequestUri\r\n    | summarize StartTime = min(TimeGenerated), EndTime = max(TimeGenerated), SessionIds = make_set(SessionId), SignInActivityIds = make_set(SignInActivityId), RequestIds = make_set(RequestId) by PrincipalId, RequestUri, RequestMethod, ResponseStatusCode, tostring(Scopes), tostring(Wids), tostring(Roles), UserAgent\r\n    | project-reorder PrincipalId, StartTime, EndTime, RequestUri, RequestMethod, ResponseStatusCode, UserAgent, SessionIds, SignInActivityIds, RequestIds",
        "size": 0,
        "title": "Agent Graph API Activity Details",
        "timeContext": {
          "durationMs": 2592000000
        },
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{SelectLogAnalytics}"
        ],
        "gridSettings": {
          "sortBy": [
            {
              "itemKey": "RequestUri",
              "sortOrder": 1
            }
          ]
        },
        "sortBy": [
          {
            "itemKey": "RequestUri",
            "sortOrder": 1
          }
        ],
        "noDataMessage": "Select an agent in the Agent Inventory to show its Microsoft Graph activity."
      },
      "name": "grid-agent-activities"
    }
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
