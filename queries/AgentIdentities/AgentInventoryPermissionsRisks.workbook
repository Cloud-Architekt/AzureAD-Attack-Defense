    {
      "type": 1,
      "content": {
        "json": "## Agent Inventory"
      },
      "name": "section-details"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let SupportedAgentTypes = dynamic([\"agenticApp\", \"agentIdentityBlueprintPrincipal\", \"agenticAppInstance\"]);\nlet AgentIdentitiesSignIns = AADServicePrincipalSignInLogs\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\n| where tostring(parse_json(Agent)[\"agentType\"]) in (SupportedAgentTypes)\n| extend AgentType = tostring(parse_json(Agent)[\"agentType\"])\n| where tostring(parse_json(Agent)[\"parentAppId\"]) =~ '{AgentBlueprintId}' or '{AgentBlueprintId}' == \"\"\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\n| extend PrincipalType = case(\n    AgentType == \"agenticApp\", \"AgentIdentityBlueprint\",\n    AgentType == \"agenticAppInstance\", \"AgentIdentity\",\n    AgentType == \"agentIdentityBlueprintPrincipal\", \"AgentIdentityBlueprintPrincipal\",\n    \"Unknown\"\n    )\n| project PrincipalType, PrincipalId = ServicePrincipalId, Identity = ServicePrincipalName, ClientCredentialType, UniqueTokenIdentifier, SessionId, NodeId = AppId, ParentNodeId = tostring(parse_json(Agent)[\"parentAppId\"]), ResultType;\nlet AgentIdentitiesIds = AgentIdentitiesSignIns | where PrincipalType == \"AgentIdentity\" | distinct NodeId;\nlet AgentUsersSignIns = AADNonInteractiveUserSignInLogs\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\n| where isnotempty(Agent)\n| where tostring(parse_json(Agent)[\"agentSubjectParentId\"]) in~ (AgentIdentitiesIds)\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\n| project PrincipalType = \"AgentUser\", PrincipalId = UserId, Identity, ClientCredentialType, UniqueTokenIdentifier, SessionId, NodeId = UserId, ParentNodeId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]), ResultType;\nunion AgentIdentitiesSignIns, AgentUsersSignIns\n| where PrincipalType in ({PrincipalType}) or '*' in ({PrincipalType})\n| where Identity contains '{IdentityFilter}' or '{IdentityFilter}' == \"\"\n| summarize SignInCount = count(), FailedSignInCount = countif(ResultType != \"0\"), CABlockedCount = countif(ResultType == \"53003\"), UniqueTokenCount = dcount(UniqueTokenIdentifier), SessionCount = dcount(SessionId), CredentialTypes = make_set(ClientCredentialType) by Identity, NodeId, ParentNodeId, PrincipalId, PrincipalType\n| join kind = leftouter (\n    union isfuzzy=true\n    (datatable(PrincipalId:string, UebaScore:real, ActionTypes:dynamic, UebaAnomalies:dynamic)[]),\n    (BehaviorAnalytics\n    | where TimeGenerated > ago(totimespan('{Lookback}'))\n    | project InvestigationPriority, ActionType, ActivityType, UsersInsights, ActivityInsights\n    | extend PrincipalId = coalesce(tostring(UsersInsights.UserId), tostring(UsersInsights.AccountObjectID))\n    | extend ActivityInsightsParsed = parse_json(ActivityInsights)\n    | mv-expand Insight = ActivityInsightsParsed\n    | extend InsightBag = bag_keys(Insight)\n    | mv-expand Key = InsightBag\n    | extend KeyStr = tostring(Key)\n    | extend Value = tostring(Insight[KeyStr])\n    | where Value =~ \"true\"\n    | summarize UebaScore = round(avg(InvestigationPriority), 2), ActionTypes = make_set(ActionType), UebaAnomalies = make_set(KeyStr) by PrincipalId)\n) on PrincipalId\n| lookup (\nunion isfuzzy=true\n(datatable(PrincipalId:string, TimeGenerated:datetime, RiskLevel:string)[]),\n(AADRiskyAgents\n| where TimeGenerated > ago(totimespan('{Lookback}'))\n| summarize arg_max(TimeGenerated, RiskLevel) by PrincipalId = Id)\n| summarize arg_max(TimeGenerated, RiskLevel) by PrincipalId\n| project PrincipalId, RiskLevel\n) on PrincipalId\n| extend RiskLevel = coalesce(RiskLevel, \"none\")\n| project NodeId, ParentNodeId, Identity, PrincipalType, PrincipalId, RiskLevel, UebaScore, UebaAnomalies, SignInCount, FailedSignInCount, CABlockedCount, SessionCount, UniqueTokenCount, CredentialTypes\n| sort by PrincipalType asc, Identity asc",
        "size": 0,
        "title": "Agent Inventory",
        "timeContext": {
          "durationMs": 2592000000
        },
        "exportFieldName": "PrincipalId",
        "exportParameterName": "SelectedPrincipal",
        "exportDefaultValue": "*",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{SelectLogAnalytics}"
        ],
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "NodeId",
              "formatter": 5
            },
            {
              "columnMatch": "ParentNodeId",
              "formatter": 5
            },
            {
              "columnMatch": "PrincipalType",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "AgentIdentityBlueprintPrincipal",
                    "representation": "Blank",
                    "text": "Blueprint Principal"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "AgentIdentityBlueprint",
                    "representation": "PowerBILogo",
                    "text": "Agent Blueprint"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "AgentIdentity",
                    "representation": "Capture",
                    "text": "Agent Identity"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "AgentUser",
                    "representation": "Person",
                    "text": "Agent User"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "Question",
                    "text": "Unknown"
                  }
                ]
              }
            },
            {
              "columnMatch": "SignInCount",
              "formatter": 4,
              "formatOptions": {
                "palette": "blue"
              }
            },
            {
              "columnMatch": "SessionCount",
              "formatter": 4,
              "formatOptions": {
                "palette": "green"
              }
            },
            {
              "columnMatch": "UniqueTokenCount",
              "formatter": 4,
              "formatOptions": {
                "palette": "yellow"
              }
            },
            {
              "columnMatch": "CredentialTypes",
              "formatter": 7,
              "formatOptions": {
                "linkTarget": "CellDetails",
                "linkIsContextBlade": true
              }
            },
            {
              "columnMatch": "RiskLevel",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "high",
                    "representation": "Sev0",
                    "text": "High"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "medium",
                    "representation": "Sev2",
                    "text": "Medium"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "low",
                    "representation": "Sev4",
                    "text": "Low"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "none",
                    "representation": "Blank",
                    "text": ""
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "Blank",
                    "text": ""
                  }
                ]
              }
            },
            {
              "columnMatch": "FailedSignInCount",
              "formatter": 4,
              "formatOptions": {
                "palette": "red"
              }
            },
            {
              "columnMatch": "CABlockedCount",
              "formatter": 4,
              "formatOptions": {
                "palette": "orange"
              }
            }
          ],
          "hierarchySettings": {
            "treeType": 0,
            "idColumn": "NodeId",
            "parentColumn": "ParentNodeId",
            "expanderColumn": "Identity",
            "expandTopLevel": true
          }
        },
        "sortBy": []
      },
      "name": "grid-agent-inventory"
    },
    {
      "type": 1,
      "content": {
        "json": "## Agent Permissions to Microsoft Graph API\nSelect an agent in the inventory above to filter permissions. Selecting a tile or chart segment in the overview (credential type, EAM tier, principal type, permission category or accessed resource) filters this grid as well."
      },
      "name": "section-permissions"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let SelectedResourceName = base64_decode_tostring('{SelectedResource:base64}');\r\nlet SupportedAgentTypes = dynamic([\"agenticApp\", \"agentIdentityBlueprintPrincipal\", \"agenticAppInstance\"]);\r\nlet AgentIdentitiesSignIns = AADServicePrincipalSignInLogs\r\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\r\n| where tostring(parse_json(Agent)[\"agentType\"]) in (SupportedAgentTypes)\r\n| extend AgentType = tostring(parse_json(Agent)[\"agentType\"])\r\n| where tostring(parse_json(Agent)[\"parentAppId\"]) =~ '{AgentBlueprintId}' or '{AgentBlueprintId}' == \"\"\r\n| extend PrincipalType = case(\r\n    AgentType == \"agenticApp\", \"AgentIdentityBlueprint\",\r\n    AgentType == \"agenticAppInstance\", \"AgentIdentity\",\r\n    AgentType == \"agentIdentityBlueprintPrincipal\", \"AgentIdentityBlueprintPrincipal\",\r\n    \"Unknown\"\r\n    )\r\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\r\n| project PrincipalType, PrincipalId = ServicePrincipalId, Identity = ServicePrincipalName, ClientCredentialType, UniqueTokenIdentifier, SessionId, AppId, ResourceDisplayName, AgentSubjectParentId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]);\r\nlet AgentIdentitiesIds = AgentIdentitiesSignIns | where PrincipalType == \"AgentIdentity\" | distinct AppId;\r\nlet AgentUsersSignIns = AADNonInteractiveUserSignInLogs\r\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\r\n| where isnotempty(Agent)\r\n| where tostring(parse_json(Agent)[\"agentSubjectParentId\"]) in~ (AgentIdentitiesIds)\r\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\r\n| project PrincipalType = \"AgentUser\", PrincipalId = UserId, Identity, ClientCredentialType, UniqueTokenIdentifier, SessionId, AppId, ResourceDisplayName, AgentSubjectParentId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]);\r\nlet AgentObjects = union AgentIdentitiesSignIns, AgentUsersSignIns\r\n| where PrincipalType in ({PrincipalType}) or '*' in ({PrincipalType})\r\n| where Identity contains '{IdentityFilter}' or '{IdentityFilter}' == \"\"\r\n| where ResourceDisplayName == SelectedResourceName or SelectedResourceName == '*'\r\n| summarize SignInCount = count(), UniqueTokenIdentifiers = make_set(UniqueTokenIdentifier), SessionIds = make_set(SessionId), CredentialType = make_set(ClientCredentialType) by Identity, AgentSubjectParentId, PrincipalId, PrincipalType;\r\nlet AgentIds = AgentObjects | summarize by PrincipalId;\r\nlet AgentIdList = toscalar(AgentIds | summarize make_set(PrincipalId));\r\nlet DirectoryRolesClassification = materialize(\r\n    externaldata(RoleId: string, RoleName: string, isPrivileged: bool, Categories: string, Classification: dynamic)\r\n    [@\"https://raw.githubusercontent.com/Cloud-Architekt/AzurePrivilegedIAM/main/Classification/Classification_EntraIdDirectoryRoles.json\"]\r\n    with (format=\"multijson\")\r\n    | project RoleId, RoleName, isPrivileged, WidsCategories = Categories, WidsEAMTierLevelName = tostring(Classification.EAMTierLevelName), WidsEAMTierLevelTagValue = tostring(Classification.EAMTierLevelTagValue)\r\n);\r\nlet AppRolesClassification = materialize(\r\n    externaldata(AppId: string, AppRoleId: string, AppRoleDisplayName: string, Category: string, EAMTierLevelName: string, EAMTierLevelTagValue: string)\r\n    [@\"https://raw.githubusercontent.com/Cloud-Architekt/AzurePrivilegedIAM/main/Classification/Classification_AppRoles.json\"]\r\n    with (format=\"multijson\")\r\n    | where AppId == \"00000003-0000-0000-c000-000000000000\"\r\n    | project-away AppId\r\n    | extend AppRoleName = AppRoleDisplayName\r\n);\r\nlet BaseData = materialize(\r\n    MicrosoftGraphActivityLogs\r\n    | where TimeGenerated > ago(totimespan('{Lookback}'))\r\n    | where UserId in~ (AgentIds) or AppId in~ (AgentIds) or ServicePrincipalId in~ (AgentIds)\r\n    | extend Scopes = split(Scopes, ' ')\r\n    | extend Roles = split(Roles, ' ')\r\n    | extend Wids = split(Wids, ' ')\r\n    | extend PrincipalId = iff(isnotempty(UserId), UserId, iff(AppId in~ (AgentIdList), AppId, iff(ServicePrincipalId in~ (AgentIdList), ServicePrincipalId, \"\")))\r\n    | where isnotempty(PrincipalId)\r\n    | project PrincipalId, Wids, Roles, Scopes, SessionId\r\n    | summarize Wids = array_concat(make_set(Wids)), Roles = array_concat(make_set(Roles)), Scopes = array_concat(make_set(Scopes)), SessionIds = make_set(SessionId) by PrincipalId\r\n);\r\nlet EnrichedWids = BaseData | project PrincipalId, Wids | mv-expand Wid = Wids to typeof(string) | where isnotempty(Wid) | lookup kind=leftouter hint.strategy=broadcast DirectoryRolesClassification on $left.Wid == $right.RoleId | summarize EnrichedWids = make_set(pack(\"RoleId\", coalesce(Wid, \"\"), \"RoleName\", coalesce(RoleName, \"\"), \"isPrivileged\", coalesce(isPrivileged, false), \"Categories\", coalesce(WidsCategories, \"\"), \"EAMTierLevel\", coalesce(WidsEAMTierLevelName, \"\"), \"EAMTierLevelTag\", coalesce(WidsEAMTierLevelTagValue, \"\"))) by PrincipalId;\r\nlet EnrichedScopes = BaseData | project PrincipalId, Scopes | mv-expand Scope = Scopes to typeof(string) | where isnotempty(Scope) | lookup kind=leftouter hint.strategy=broadcast AppRolesClassification on $left.Scope == $right.AppRoleName | summarize EnrichedScopes = make_set(pack(\"PermissionValue\", coalesce(Scope, \"\"), \"AppRoleName\", coalesce(AppRoleDisplayName, \"\"), \"Category\", coalesce(Category, \"\"), \"EAMTierLevel\", coalesce(EAMTierLevelName, \"\"), \"EAMTierLevelTag\", coalesce(EAMTierLevelTagValue, \"\"))) by PrincipalId;\r\nlet EnrichedRoles = BaseData | project PrincipalId, Roles | mv-expand Role = Roles to typeof(string) | where isnotempty(Role) | lookup kind=leftouter hint.strategy=broadcast AppRolesClassification on $left.Role == $right.AppRoleName | summarize EnrichedRoles = make_set(pack(\"PermissionValue\", coalesce(Role, \"\"), \"AppRoleName\", coalesce(AppRoleDisplayName, \"\"), \"Category\", coalesce(Category, \"\"), \"EAMTierLevel\", coalesce(EAMTierLevelName, \"\"), \"EAMTierLevelTag\", coalesce(EAMTierLevelTagValue, \"\"))) by PrincipalId;\r\nlet AgentEnrichedData = BaseData\r\n| project PrincipalId\r\n| join kind=leftouter EnrichedWids on PrincipalId\r\n| join kind=leftouter EnrichedRoles on PrincipalId\r\n| join kind=leftouter EnrichedScopes on PrincipalId\r\n| project PrincipalId, EnrichedWids, EnrichedRoles, EnrichedScopes\r\n| mv-apply WidsItem = EnrichedWids on (summarize WidsCategories = make_set(tostring(WidsItem.Categories)), WidsEAMTiers = make_set(tostring(WidsItem.EAMTierLevel)))\r\n| mv-apply RolesItem = EnrichedRoles on (summarize RolesCategories = make_set(tostring(RolesItem.Category)), RolesEAMTiers = make_set(tostring(RolesItem.EAMTierLevel)))\r\n| mv-apply ScopesItem = EnrichedScopes on (summarize ScopesCategories = make_set(tostring(ScopesItem.Category)), ScopesEAMTiers = make_set(tostring(ScopesItem.EAMTierLevel)))\r\n| extend AllCategories = set_difference(set_union(WidsCategories, RolesCategories, ScopesCategories), dynamic([\"\"])),\r\n         AllEAMTiers = set_difference(set_union(WidsEAMTiers, RolesEAMTiers, ScopesEAMTiers), dynamic([\"\"]))\r\n| extend HighestEAMTierLevel = case(set_has_element(AllEAMTiers, \"ControlPlane\"), \"ControlPlane\", set_has_element(AllEAMTiers, \"ManagementPlane\"), \"ManagementPlane\", set_has_element(AllEAMTiers, \"WorkloadPlane\"), \"WorkloadPlane\", set_has_element(AllEAMTiers, \"UserAccess\"), \"UserAccess\", \"\")\r\n| project PrincipalId, EnrichedWids, EnrichedRoles, EnrichedScopes, AllCategories, HighestEAMTierLevel;\r\nlet AgentResult = AgentObjects\r\n| join kind=leftouter (AgentEnrichedData) on PrincipalId\r\n| extend HighestEAMTierLevel = coalesce(HighestEAMTierLevel, \"Unclassified\")\r\n| extend AllCategories = iff(isnull(AllCategories), dynamic([]), AllCategories)\r\n| where HighestEAMTierLevel == '{SelectedEAMTier}' or '*' == '{SelectedEAMTier}'\r\n| where PrincipalType == '{SelectedPrincipalType}' or '*' == '{SelectedPrincipalType}'\r\n| where set_has_element(CredentialType, '{SelectedCredentialType}') or '*' == '{SelectedCredentialType}'\r\n| where set_has_element(AllCategories, '{SelectedCategory}') or '*' == '{SelectedCategory}'\r\n| where PrincipalId == '{SelectedPrincipal}' or AgentSubjectParentId == '{SelectedPrincipal}' or '*' == '{SelectedPrincipal}';\r\nlet WidsRows = AgentResult\r\n| mv-expand WidsItem = EnrichedWids\r\n| where isnotempty(tostring(WidsItem.RoleId))\r\n| project Identity, PrincipalType, PrincipalId, AgentSubjectParentId, HighestEAMTierLevel, SignInCount, CredentialType, RoleValue = tostring(WidsItem.RoleId), RoleType = \"EntraID\", RoleName = iff(isnotempty(tostring(WidsItem.RoleName)), tostring(WidsItem.RoleName), tostring(WidsItem.RoleId)), Category = tostring(WidsItem.Categories), AdminTierLevelName = tostring(WidsItem.EAMTierLevel);\r\nlet RolesRows = AgentResult\r\n| mv-expand RolesItem = EnrichedRoles\r\n| where isnotempty(tostring(RolesItem.PermissionValue))\r\n| project Identity, PrincipalType, PrincipalId, AgentSubjectParentId, HighestEAMTierLevel, SignInCount, CredentialType, RoleValue = tostring(RolesItem.PermissionValue), RoleType = \"Application API Permissions\", RoleName = iff(isnotempty(tostring(RolesItem.AppRoleName)), tostring(RolesItem.AppRoleName), tostring(RolesItem.PermissionValue)), Category = tostring(RolesItem.Category), AdminTierLevelName = tostring(RolesItem.EAMTierLevel);\r\nlet ScopesRows = AgentResult\r\n| mv-expand ScopesItem = EnrichedScopes\r\n| where isnotempty(tostring(ScopesItem.PermissionValue))\r\n| project Identity, PrincipalType, PrincipalId, AgentSubjectParentId, HighestEAMTierLevel, SignInCount, CredentialType, RoleValue = tostring(ScopesItem.PermissionValue), RoleType = \"Delegated API Permissions\", RoleName = iff(isnotempty(tostring(ScopesItem.AppRoleName)), tostring(ScopesItem.AppRoleName), tostring(ScopesItem.PermissionValue)), Category = tostring(ScopesItem.Category), AdminTierLevelName = tostring(ScopesItem.EAMTierLevel);\r\nunion WidsRows, RolesRows, ScopesRows\r\n| extend Category = coalesce(Category, \"Unclassified\")\r\n| project-away PrincipalId, AgentSubjectParentId\r\n| extend CategoryEam = strcat(AdminTierLevelName, \" - \", Category)\r\n| extend CategoryEam = iff(Category == \"Unclassified\", \"Unclassified\", CategoryEam)\r\n| extend TierRank = case(AdminTierLevelName == \"ControlPlane\", 1, AdminTierLevelName == \"ManagementPlane\", 2, AdminTierLevelName == \"WorkloadPlane\", 3, AdminTierLevelName == \"UserAccess\", 4, 5)\r\n| sort by Identity asc, RoleType asc, TierRank asc, RoleName asc\r\n| project-away TierRank",
        "size": 0,
        "title": "Agent Graph API Permission Details",
        "timeContext": {
          "durationMs": 2592000000
        },
        "exportFieldName": "RoleValue",
        "exportParameterName": "SelectedRoleName",
        "exportDefaultValue": "*",
        "exportToExcelOptions": "all",
