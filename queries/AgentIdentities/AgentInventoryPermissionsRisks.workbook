      "content": {
        "version": "KqlItem/1.0",
        "query": "let SupportedAgentTypes = dynamic([\"agenticApp\", \"agentIdentityBlueprintPrincipal\", \"agenticAppInstance\"]);\r\nlet AgentIdentitiesSignIns = AADServicePrincipalSignInLogs\r\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\r\n| where tostring(parse_json(Agent)[\"agentType\"]) in (SupportedAgentTypes)\r\n| extend AgentType = tostring(parse_json(Agent)[\"agentType\"])\r\n| where tostring(parse_json(Agent)[\"parentAppId\"]) =~ '{AgentBlueprintId}' or '{AgentBlueprintId}' == \"\"\r\n| extend PrincipalType = case(\r\n    AgentType == \"agenticApp\", \"AgentIdentityBlueprint\",\r\n    AgentType == \"agenticAppInstance\", \"AgentIdentity\",\r\n    AgentType == \"agentIdentityBlueprintPrincipal\", \"AgentIdentityBlueprintPrincipal\",\r\n    \"Unknown\"\r\n    )\r\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\r\n| project PrincipalType, PrincipalId = ServicePrincipalId, Identity = ServicePrincipalName, ClientCredentialType, AppId, AgentSubjectParentId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]), CreatedDateTime;\r\nlet AgentIdentitiesIds = AgentIdentitiesSignIns | where PrincipalType == \"AgentIdentity\" | distinct AppId;\r\nlet AgentUsersSignIns = AADNonInteractiveUserSignInLogs\r\n| where TimeGenerated > ago(totimespan('{Lookback}') + 1d)\r\n| where isnotempty(Agent)\r\n| where tostring(parse_json(Agent)[\"agentSubjectParentId\"]) in~ (AgentIdentitiesIds)\r\n| where CreatedDateTime > ago(totimespan('{Lookback}'))\r\n| project PrincipalType = \"AgentUser\", PrincipalId = UserId, Identity, ClientCredentialType, AppId, AgentSubjectParentId = tostring(parse_json(Agent)[\"agentSubjectParentId\"]), CreatedDateTime;\r\nunion AgentIdentitiesSignIns, AgentUsersSignIns\r\n| where PrincipalType in ({PrincipalType}) or '*' in ({PrincipalType})\r\n| where Identity contains '{IdentityFilter}' or '{IdentityFilter}' == \"\"\r\n| summarize SignInCount = count() by bin(CreatedDateTime, 1d), PrincipalType\r\n| order by CreatedDateTime asc",
